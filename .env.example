# Copy this file to .env.local for local development.
# In production, add the same variables in Vercel > Project > Settings > Environment Variables.
# Never commit real values. Nothing here may be prefixed with NEXT_PUBLIC_ except the site URL.

# ---------------------------------------------------------------------------
# Admin authentication (only the institute administrator logs in)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=jainclasses.official@gmail.com
# Generate both values below with:  npm run admin:create
ADMIN_PASSWORD_HASH=b64:PASTE_VALUE_FROM_SCRIPT
AUTH_SECRET=PASTE_VALUE_FROM_SCRIPT

# ---------------------------------------------------------------------------
# CMS backend — Upstash Redis (recommended, free tier, no GCP required)
# ---------------------------------------------------------------------------
# 1. Create a free database at https://console.upstash.com
# 2. Copy the REST URL and REST Token from the database dashboard.
UPSTASH_REDIS_REST_URL=https://YOUR-DB.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN_HERE

# ---------------------------------------------------------------------------
# CMS backend — Google Sheets (legacy / optional alternative to Upstash)
# If UPSTASH_REDIS_REST_URL is set, Upstash is used and these are ignored.
# ---------------------------------------------------------------------------
# GOOGLE_SERVICE_ACCOUNT_EMAIL=jain-classes-cms@your-project-id.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SHEETS_SPREADSHEET_ID=

# ---------------------------------------------------------------------------
# Website
# ---------------------------------------------------------------------------
# Public address of the site, without a trailing slash (used for SEO links).
NEXT_PUBLIC_SITE_URL=https://www.example.com
